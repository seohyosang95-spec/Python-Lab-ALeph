    {
      "parameters": {
        "jsCode": "const items_in = $input.all();\nconst results = [];\nconst DENY_THRESHOLD = 10;\n\nfor (const item of items_in) {\n  const json_data = item.json || {};\n  const student = json_data.student || \"Unknown\";\n  const alerts = json_data.alerts || [];\n\n  for (const alert of alerts) {\n    const level = alert.level;\n    const rule = alert.rule;\n    const src_ip = alert.ip;\n\n    let severity = 'Low';\n    let decision = 'allow';\n\n    if (level >= DENY_THRESHOLD) {\n      severity = 'High';\n      decision = 'deny';\n    } else if (level >= 7) {\n      severity = 'Medium';\n      decision = 'allow';\n    }\n\n    const reason = `level ${level} (rule ${rule}) → ${decision}`;\n\n    results.push({\n      json: {\n        student: student,\n        src_ip: src_ip,\n        level: level,\n        rule: rule,\n        fail_count: 1,\n        severity: severity,\n        decision: decision,\n        reason: reason,\n      },\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "id": "code-node-1",
      "name": "판정 (Python)"
    },
