# 이 파일을 .env 로 복사한 뒤 각자 값으로 채운다. .env 는 커밋되지 않는다.
# docker-compose.yml 과 app.py 가 같은 .env 를 읽는다.

# --- 도커 MySQL (docker compose up -d) ---
# 다른 실습이 3306 을 쓰고 있어도 겹치지 않도록 호스트 포트는 3307 을 쓴다.
MYSQL_ROOT_PASSWORD=<긴 랜덤 문자열>
MYSQL_DATABASE=shs95_board_db
MYSQL_HOST_PORT=3307

# --- Flask ---
# 위 세 값과 반드시 일치해야 한다.
DATABASE_URL=mysql+pymysql://root:<위와 같은 비밀번호>@localhost:3307/shs95_board_db
JWT_SECRET_KEY=<32자 이상 랜덤 문자열>
JWT_COOKIE_SECURE=0
PUBLIC_API_KEY=<공공데이터포털 서비스키>
PORT=5001
