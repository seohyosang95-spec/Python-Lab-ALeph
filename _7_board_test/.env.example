# 이 파일을 .env 로 복사한 뒤 각자 PC 값으로 채운다. .env 는 커밋되지 않는다.

# DB 접속 정보. 지정하지 않으면 app.py 의 기본값을 그대로 쓴다.
DATABASE_URL=mysql+pymysql://<계정>:<비밀번호>@localhost:3306/<스키마>

# 로그인 토큰 서명 키
JWT_SECRET_KEY=<32자 이상 랜덤 문자열>

# 로그인 토큰을 쿠키로도 발급한다. https 배포에서는 1
JWT_COOKIE_SECURE=0

# 공공데이터포털 일반 인증키(Decoding)
PUBLIC_API_KEY=<공공데이터포털 서비스키>

# 다른 실습 서버와 포트가 겹칠 때만 지정
PORT=5000
